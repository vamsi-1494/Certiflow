# ==========================================
# CertiFlow Environment Configuration Template
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://certiflow_user:certiflow_password@localhost:5432/certiflow_db

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secret for Authentication
JWT_SECRET=super_secret_jwt_key_pragati_mission_2026
JWT_EXPIRES_IN=24h

# Business Logic Configuration
# Threshold above which batches require Quality Team review (Neha)
LARGE_BATCH_THRESHOLD=50

# Overdue SLA (in hours) - batches pending longer than this are flagged
BATCH_OVERDUE_SLA_HOURS=48

# Simulated WhatsApp Provider
SIMULATE_WHATSAPP_FAILURE_RATE=0.20
SIMULATE_WHATSAPP_DELAY_MS=1500

# File Storage
CERTIFICATE_STORAGE_DIR=./storage/certificates
PUBLIC_FRONTEND_URL=http://localhost:5173
